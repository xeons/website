@*
    Shared 404 body, used both by the dedicated route and by pages whose lookup came up empty.
*@
<SeoHead Title="Page not found" NoIndex="true" />

<PageShell>
    <article class="entry">
        <header class="entry-header">
            <h1 class="entry-title">Page not found</h1>
        </header>
        <div class="entry-content">
            <p>
                That address does not match anything here. It may have moved when the site was
                rebuilt, or the link may simply be wrong.
            </p>
            <p>
                Try the <a href="/">latest posts</a>, or
                <a href="/search">search the site</a>.
            </p>
        </div>
    </article>
</PageShell>

