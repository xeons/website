@inject NavigationManager Navigation

@code {
    /// <summary>
    /// Sends an anonymous visitor to the login form, remembering where they were headed.
    /// </summary>
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/admin/login?returnUrl={Uri.EscapeDataString("/" + returnUrl)}", forceLoad: true);
    }
}
