@*
    Random secrets from crypto.getRandomValues. The entropy figure is the real one for how the
    string was generated, log2 of the pool size times the length, not a guess at how strong it
    looks.
*@

<div class="tool" data-tool="password">
    <div class="tool-options">
        <label class="tool-inline">
            Style
            <select data-tool-option="style">
                <option value="password">Password: a random string</option>
                <option value="passphrase">Passphrase: random words</option>
            </select>
        </label>

        <label class="tool-inline">
            Length
            <input type="number" data-tool-option="length" value="24" min="4" max="256" />
        </label>

        <label class="tool-inline">
            How many
            <input type="number" data-tool-option="count" value="5" min="1" max="100" />
        </label>
    </div>

    <div class="tool-options" data-password-charset>
        <label class="tool-check">
            <input type="checkbox" data-tool-option="lower" checked />
            Lower case
        </label>
        <label class="tool-check">
            <input type="checkbox" data-tool-option="upper" checked />
            Upper case
        </label>
        <label class="tool-check">
            <input type="checkbox" data-tool-option="digits" checked />
            Digits
        </label>
        <label class="tool-check">
            <input type="checkbox" data-tool-option="symbols" checked />
            Symbols
        </label>
        <label class="tool-check">
            <input type="checkbox" data-tool-option="ambiguous" />
            Exclude look-alikes (I l 1 O 0)
        </label>
    </div>

    <div class="tool-actions">
        <button type="button" class="btn" data-tool-run="generate">Generate</button>
        <button type="button" class="btn btn-secondary" data-tool-copy>Copy all</button>
    </div>

    <div class="tool-field">
        <label for="pw-out">Output</label>
        <textarea id="pw-out" data-tool-output rows="7" spellcheck="false" readonly></textarea>
    </div>

    <p class="tool-hint">
        Length is characters for a password. For a passphrase it is divided by four to give
        the number of words, so 24 produces six. The entropy below is the figure for how the
        result was actually generated, not a guess at how strong it looks.
    </p>

    <p class="tool-strength" data-password-entropy></p>
    <p class="tool-status" data-tool-status role="status"></p>
</div>
