@*
    Text to and from hexadecimal, one pair of digits per UTF-8 byte. Decoding ignores any
    separator and an optional 0x prefix, so hex copied out of a debugger pastes in as it is.
*@

<div class="tool" data-tool="hex">
    <div class="tool-io">
        <div class="tool-field">
            <label for="hex-in">Input</label>
            <textarea id="hex-in" data-tool-input rows="7" spellcheck="false"
                      placeholder="Text to encode, or hex to decode"></textarea>
        </div>
        <div class="tool-field">
            <label for="hex-out">Output</label>
            <textarea id="hex-out" data-tool-output rows="7" spellcheck="false" readonly></textarea>
        </div>
    </div>

    <div class="tool-options">
        <label class="tool-inline">
            Separator
            <select data-tool-option="separator">
                <option value="">None</option>
                <option value=" ">Space</option>
                <option value=":">Colon</option>
                <option value="-">Hyphen</option>
            </select>
        </label>

        <label class="tool-check">
            <input type="checkbox" data-tool-option="upper" />
            Upper case
        </label>
    </div>

    <div class="tool-actions">
        <button type="button" class="btn" data-tool-run="encode">Encode</button>
        <button type="button" class="btn btn-secondary" data-tool-run="decode">Decode</button>
        <button type="button" class="btn btn-secondary" data-tool-swap>Swap</button>
        <button type="button" class="btn btn-secondary" data-tool-copy>Copy output</button>
        <button type="button" class="btn btn-secondary" data-tool-clear>Clear</button>
    </div>

    <p class="tool-status" data-tool-status role="status"></p>
</div>
