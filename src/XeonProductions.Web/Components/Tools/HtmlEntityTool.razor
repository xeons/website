@*
    HTML entity escaping. The strict mode escapes only the five characters that carry meaning
    in markup; the full mode escapes everything above ASCII as a numeric reference, which is
    what a document in an unknown encoding needs.
*@

<div class="tool" data-tool="entities">
    <div class="tool-io">
        <div class="tool-field">
            <label for="ent-in">Input</label>
            <textarea id="ent-in" data-tool-input rows="7" spellcheck="false"
                      placeholder="Text to escape, or entities to decode"></textarea>
        </div>
        <div class="tool-field">
            <label for="ent-out">Output</label>
            <textarea id="ent-out" data-tool-output rows="7" spellcheck="false" readonly></textarea>
        </div>
    </div>

    <div class="tool-options">
        <label class="tool-inline">
            Encode
            <select data-tool-option="scope">
                <option value="markup">Only the markup characters: &amp; &lt; &gt; " '</option>
                <option value="all">Every character above ASCII as well</option>
            </select>
        </label>
    </div>

    <div class="tool-actions">
        <button type="button" class="btn" data-tool-run="encode">Encode</button>
        <button type="button" class="btn btn-secondary" data-tool-run="decode">Decode</button>
        <button type="button" class="btn btn-secondary" data-tool-swap>Swap</button>
        <button type="button" class="btn btn-secondary" data-tool-copy>Copy output</button>
        <button type="button" class="btn btn-secondary" data-tool-clear>Clear</button>
    </div>

    <p class="tool-status" data-tool-status role="status"></p>
</div>
