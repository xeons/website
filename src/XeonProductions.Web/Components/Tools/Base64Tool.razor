@*
    Text to and from Base64. The conversion goes through UTF-8 bytes rather than btoa on the
    string, so characters outside Latin-1 survive the round trip.
*@

<div class="tool" data-tool="base64">
    <div class="tool-io">
        <div class="tool-field">
            <label for="b64-in">Input</label>
            <textarea id="b64-in" data-tool-input rows="7" spellcheck="false"
                      placeholder="Text to encode, or Base64 to decode"></textarea>
        </div>
        <div class="tool-field">
            <label for="b64-out">Output</label>
            <textarea id="b64-out" data-tool-output rows="7" spellcheck="false" readonly></textarea>
        </div>
    </div>

    <div class="tool-options">
        <label class="tool-check">
            <input type="checkbox" data-tool-option="urlsafe" />
            URL-safe alphabet: <code>-</code> and <code>_</code> in place of
            <code>+</code> and <code>/</code>, no padding
        </label>
    </div>

    <div class="tool-actions">
        <button type="button" class="btn" data-tool-run="encode">Encode</button>
        <button type="button" class="btn btn-secondary" data-tool-run="decode">Decode</button>
        <button type="button" class="btn btn-secondary" data-tool-swap>Swap</button>
        <button type="button" class="btn btn-secondary" data-tool-copy>Copy output</button>
        <button type="button" class="btn btn-secondary" data-tool-clear>Clear</button>
    </div>

    <p class="tool-status" data-tool-status role="status"></p>
</div>
