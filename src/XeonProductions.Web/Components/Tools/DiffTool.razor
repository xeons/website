@*
    Line-level comparison over a longest-common-subsequence table. That table is quadratic in
    the line counts, so very large inputs are refused rather than left to grind.
*@

<div class="tool" data-tool="diff">
    <div class="tool-io">
        <div class="tool-field">
            <label for="diff-a">Original</label>
            <textarea id="diff-a" data-tool-input rows="10" spellcheck="false"
                      placeholder="The first version"></textarea>
        </div>
        <div class="tool-field">
            <label for="diff-b">Changed</label>
            <textarea id="diff-b" data-tool-input-2 rows="10" spellcheck="false"
                      placeholder="The second version"></textarea>
        </div>
    </div>

    <div class="tool-options">
        <label class="tool-check">
            <input type="checkbox" data-tool-option="trim" />
            Ignore leading and trailing whitespace
        </label>

        <label class="tool-check">
            <input type="checkbox" data-tool-option="ignorecase" />
            Ignore case
        </label>
    </div>

    <div class="tool-actions">
        <button type="button" class="btn" data-tool-run="compare">Compare</button>
        <button type="button" class="btn btn-secondary" data-tool-clear>Clear</button>
    </div>

    <div class="tool-result" data-tool-result></div>

    <p class="tool-status" data-tool-status role="status"></p>
</div>
