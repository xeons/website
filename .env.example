# Copy to .env and fill in. Never commit the real .env.

SITE_DOMAIN=xeonproductions.com

# Loopback port the app publishes on, for a reverse proxy already running on the host.
# Not used when Caddy is running the front door.
APP_PORT=8080

POSTGRES_DB=xeon
POSTGRES_USER=xeon
POSTGRES_PASSWORD=

# Created on the first run only. Leave blank to skip account creation entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Brandon

# Largest single download that may be uploaded, in bytes. Default 2 GB.
DOWNLOAD_MAX_BYTES=2147483648

# Contact form delivery. With SMTP_ENABLED=false, messages are still stored and
# readable in the admin, they are just not emailed on.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@xeonproductions.com
SMTP_TO=
