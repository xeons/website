# Data protection key ring. These sign the auth cookies and antiforgery tokens,
# so they are secrets even though nothing here generates them deliberately.
keys/
src/XeonProductions.Web/keys/

# Uploaded media and downloads belong to the running site, not to the source tree.
src/XeonProductions.Web/media/
src/XeonProductions.Web/downloads/

# Working notes: design reasoning, diagnosed bugs, anything that would otherwise become a
# large explanatory comment. Deliberately never committed.
NOTES.local.md
*.local.md

# Any environment-specific settings written locally.
src/XeonProductions.Web/appsettings.Production.json
**/appsettings.*.local.json

# Caddy state
deploy/data/
